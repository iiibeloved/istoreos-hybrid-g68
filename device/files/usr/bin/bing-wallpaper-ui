#!/bin/sh
# =============================================================================
#  把「登录背景（默认 / 必应每日壁纸）」下拉整合进 LuCI 的
#  「系统 → 系统属性 → 语言和界面」页面。
#
#  做法：对已安装的 luci-mod-system 视图做幂等注入（带标记），不覆盖整文件；
#  luci-mod-system 升级后视图被替换时，开机脚本会重新注入。
#  备份：/etc/bing-wallpaper/system.js.orig（首次注入前保存）
# =============================================================================
set -eu
VIEW=/www/luci-static/resources/view/system/system.js
BK=/etc/bing-wallpaper
[ -f "$VIEW" ] || { echo "找不到 $VIEW"; exit 0; }
mkdir -p "$BK"
grep -q "bing-wallpaper-ui:begin" "$VIEW" && { echo "已注入，跳过"; exit 0; }

[ -f "$BK/system.js.orig" ] || cp -f "$VIEW" "$BK/system.js.orig"

TMP=$(mktemp)
cp -f "$VIEW" "$TMP"
# 1) load 里加载 argon 配置
grep -q "uci.load('argon')" "$TMP" || \
	sed -i "s/uci\.load('system')/uci.load('system'),uci.load('argon')/" "$TMP"
# 2) 在 tablefilters 选项后追加「登录背景」下拉
awk '
	/tablefilters/ && !done {
		print
		print "/* bing-wallpaper-ui:begin */"
		print "var fs=require(\"fs\");"
		print "o=s.taboption(\"language\",form.ListValue,\"_bingwallpaper\",_(\"登录背景\"));"
		print "o.value(\"none\",_(\"默认（跟随主题）\"));"
		print "o.value(\"bing\",_(\"必应每日壁纸\"));"
		print "o.cfgvalue=function(){var v=uci.get(\"argon\",\"@global[0]\",\"online_wallpaper\");return v===\"bing\"?\"bing\":\"none\";};"
		print "o.write=function(section_id,value){return fs.exec(\"/usr/bin/bing-wallpaper\",[value===\"bing\"?\"enable\":\"disable\"]);};"
		print "/* bing-wallpaper-ui:end */"
		done=1; next
	}
	{ print }
' "$TMP" > "$TMP.new"
mv "$TMP.new" "$TMP"

grep -q "bing-wallpaper-ui:begin" "$TMP" || { echo "注入失败：未找到 tablefilters"; rm -f "$TMP"; exit 1; }
cp -f "$TMP" "$VIEW"
rm -f "$TMP"
rm -f /tmp/luci-indexcache* 2>/dev/null || true
echo "已注入「登录背景」下拉到 语言和界面"
