#!/bin/sh /etc/rc.common
# 启动后记录网络诊断快照，供无法联网时读取
START=99
start() {
	OUT=/etc/g68-diag.log
	{
		echo "===== $(date) ====="
		echo "--- model/board ---"
		tr -d '\0' < /proc/device-tree/model 2>/dev/null; echo
		cat /tmp/sysinfo/board_name 2>/dev/null
		echo "--- ip link ---"
		ip -br link 2>/dev/null
		echo "--- ip addr ---"
		ip -br addr 2>/dev/null
		echo "--- uci network ---"
		uci show network 2>/dev/null
		echo "--- ethtool ---"
		for n in /sys/class/net/*; do
			i=$(basename "$n")
			case "$i" in lo|docker*|veth*|br-lan) continue ;; esac
			echo "[$i]"; ethtool "$i" 2>/dev/null | grep -E "Speed|Link detected|Duplex"
		done
		echo "--- dmesg (gmac/phy/switch/dsa/sgmii/xpcs) ---"
		dmesg 2>/dev/null | grep -iE "gmac|dwmac|phy|switch|dsa|sgmii|xpcs|rtl" | tail -80
		echo "--- mdio buses ---"
		ls /sys/bus/mdio_bus/devices 2>/dev/null
		echo "--- switch driver ---"
		ls /sys/bus/mdio_bus/devices/*/driver 2>/dev/null
	} > "$OUT" 2>&1
}
