#!/bin/sh /etc/rc.common
# =============================================================================
#  诊断用：把全部以太网口桥进 br-lan，强制 192.168.100.1/24 + DHCP
#  目的：不管 WAN/LAN 映射与 SGMII 链路是否正常，只要能连上任一口就能进系统
#  注意：本版无 WAN/NAT，仅用于定位问题
# =============================================================================
START=19
LOG=/etc/g68-network.log

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

start() {
	[ -f "$LOG" ] || : > "$LOG"
	MODEL=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null)
	log "diag mode, model='$MODEL'"

	PORTS=""
	for d in /sys/class/net/*; do
		n=$(basename "$d")
		case "$n" in lo|br-*|docker*|veth*|dummy*|ifb*|tun*|tap*|sit*|wg*|ppp*|lan[0-9]*) continue ;; esac
		PORTS="$PORTS $n"
	done
	# DSA slave 口也加入
	for p in lan1 lan2 lan3 lan4; do
		[ -e "/sys/class/net/$p" ] && PORTS="$PORTS $p"
	done
	log "bridging ports:$PORTS"

	for sect in network.lan network.wan network.wan6 dhcp.lan network.brlan; do
		uci -q delete "$sect" 2>/dev/null || true
	done

	uci -q batch <<UCIEOF
set network.brlan=device
set network.brlan.name='br-lan'
set network.brlan.type='bridge'
commit network
UCIEOF
	for p in $PORTS; do uci -q add_list network.brlan.ports="$p"; done
	uci -q commit network

	uci -q batch <<UCIEOF
set network.lan=interface
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.100.1'
set network.lan.netmask='255.255.255.0'
commit network
set dhcp.lan=dhcp
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
commit dhcp
UCIEOF

	log "br-lan ports=$PORTS lan=192.168.100.1"
}
