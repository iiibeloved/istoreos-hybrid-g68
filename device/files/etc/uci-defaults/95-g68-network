#!/bin/sh
# =============================================================================
#  G68 以太网端口映射（首次启动执行一次）
#
#  硬件事实（与 immortalwrt standalone 一致）：
#    LAN = eth0  → gmac1，SGMII fixed-link，接 RTL8367S 交换芯片（其余网口）
#    WAN = eth1  → gmac0，RGMII，接 RTL8211F PHY（靠近电源的网口）
#
#  iStoreOS 基座的 02_network 没有 nsy,g68-plus 分支，会落到默认分支
#  "ucidef_set_interface_lan 'eth0' 'dhcp'"：只生成 lan=eth0 且为 dhcp，
#  没有 wan —— 真机表现为直连拿不到地址 / 接上级路由变成交换机模式。
#
#  本脚本在 /etc/init.d/boot 阶段（network 启动前）修正为：
#    lan: eth0, static 192.168.100.1/24 + DHCP 服务
#    wan: eth1, dhcp（+ wan6 dhcpv6）
# =============================================================================
LOG=/etc/g68-network.log
log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

BOARD=$(cat /tmp/sysinfo/board_name 2>/dev/null)
if [ "$BOARD" != "nsy,g68-plus" ]; then
	log "board=$BOARD，跳过 G68 网络修正"
	exit 0
fi

uci -q batch <<'UCIEOF'
delete network.lan
set network.lan=interface
set network.lan.device='eth0'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.100.1'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign='60'
delete network.wan
set network.wan=interface
set network.wan.device='eth1'
set network.wan.proto='dhcp'
delete network.wan6
set network.wan6=interface
set network.wan6.device='eth1'
set network.wan6.proto='dhcpv6'
commit network

delete dhcp.lan
set dhcp.lan=dhcp
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
commit dhcp
UCIEOF

log "已设置 lan=eth0(192.168.100.1/24) / wan=eth1(dhcp)"
exit 0
