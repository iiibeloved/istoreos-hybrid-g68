#!/bin/sh
# =============================================================================
#  NSY G68-PLUS 板级网络映射（补充 iStoreOS 上游 02_network 未收录的板型）
#
#  board_detect 会按字母序 source /etc/board.d/*，本文件名排在 02_network 之后，
#  因此只在本文件内覆盖 G68 的映射，不修改上游 02_network 本体 ——
#  上游更新 02_network 时本文件不受影响，G68 网络映射照旧生效。
#
#  拓扑（与 immortalwrt standalone 真机验证一致）：
#    RTL8367S 交换芯片，CPU 口 6（SGMII）→ eth0，7（RGMII）→ eth1；
#    物理口 0-3 = LAN，4 = WAN；LAN/WAN 各占 1G 上行。
#  MAC：由 eMMC CID 派生（wan=基址，lan=+1），与 standalone 一致。
# =============================================================================
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update

case "$(board_name)" in
nsy,g68-plus)
	ucidef_set_interfaces_lan_wan "eth0" "eth1"
	ucidef_add_switch "switch0" \
		"0:lan" "1:lan" "2:lan" "3:lan" "4:wan" "6u@eth0" "7u@eth1"

	wan_mac=$(macaddr_generate_from_mmc_cid mmcblk0)
	lan_mac=$(macaddr_add "$wan_mac" 1)
	ucidef_set_interface_macaddr "lan" "$lan_mac"
	ucidef_set_interface_macaddr "wan" "$wan_mac"
	;;
esac

board_config_flush

exit 0
