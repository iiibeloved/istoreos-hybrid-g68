# =============================================================================
#  NSY G68-PLUS (RK3568) · iStoreOS 24.10 杂交固件
#  基座：istoreos/istoreos @ istoreos-24.10（内核 6.6 / u-boot 2024.10）
#
#  说明：本文件是"首版可启动"的最小配置，用于验证 内核/uboot/DTS/分区/按键；
#        通过后按 docs/design.md 的 Phase 2 逐步把 immortalwrt 的 565 个应用映射补齐。
# =============================================================================

# ---- 目标与设备 ----
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_nsy_g68-plus=y
CONFIG_PACKAGE_u-boot-nsy-g68-plus-rk3568=y

# ---- 分区：kernel 16MiB / rootfs 200MiB / rootfs_data 2048MiB（iStoreOS 脚本默认） ----
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=200
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# ---- 基础系统 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-mod-dashboard=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tmux=y

# ---- iStore 商店（iStoreOS 官方 feed）----
CONFIG_PACKAGE_luci-app-store=y

# ---- 存储/共享 ----
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# ---- 网络工具 ----
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
